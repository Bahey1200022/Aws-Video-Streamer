# {{ ansible_managed }}
user www-data;
worker_processes  1;
pid /run/nginx.pid;
# Loads ngx_rtmp_module (installed by libnginx-mod-rtmp)
include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections  1024;
}

http {
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;
    types_hash_max_size 2048;

    include         /etc/nginx/mime.types;
    include         /etc/nginx/sites-enabled/*;

    default_type    application/octet-stream;

    # Publish authentication: nginx-rtmp asks this endpoint before accepting
    # a stream. Each channel has its own key: "stream" (the video loop) and
    # "phone" (the phone camera). A key only opens its own channel.
    map "$arg_name:$arg_key" $publish_allowed {
        default                     0;
        "stream:{{ stream_key }}"   1;
{% if phone_camera | default(false) | bool %}
        "phone:{{ phone_stream_key }}"    1;
{% endif %}
    }


    # Logs who tried to publish and the verdict - never the key itself
    log_format publish_auth '$time_iso8601 addr=$arg_addr app=$arg_app '
                            'name=$arg_name result=$status';

    server {
        listen 127.0.0.1:8081;
        access_log /var/log/nginx/publish-auth.log publish_auth;

        location = /auth/publish {
            if ($publish_allowed) {
                return 200;
            }
            return 403;
        }


        location / {
            return 404;
        }
    }

    # nginx-rtmp's admin interface (list streams, drop clients) has no
    # password: only listen on localhost, so it's reachable from the frontend
    # itself and nowhere else - not the VPC, not the WireGuard tunnel
    server {
        listen 127.0.0.1:8080;

        # rtmp control
        location /control {
            rtmp_control all;
        }

        # Stream statistics (XML: publisher, bitrate, clients), read every
        # 15 s by the mss-stream-metrics collector for the monitoring
        location /stat {
            rtmp_stat all;
        }
    }
}

rtmp {
    # The default RTMP log format records the connection arguments, which
    # include the stream key - log everything except them
    log_format rtmp_nokey '$remote_addr [$time_local] $command "$app" "$name" '
                          '$bytes_received $bytes_sent ($session_readable_time)';
    access_log /var/log/nginx/rtmp-access.log rtmp_nokey;

    server {
        listen 1935;
        chunk_size 4096;

        application live {
            live on;
            record off;

            # A phone on 4G can vanish without closing its connection. Drop a
            # publisher that has sent nothing for 10 s, so its reconnection
            # isn't refused with "already publishing"
            drop_idle_publisher 10s;

            # Layer 1: network - only WireGuard addresses (the streamer, the
            # phone) or localhost may publish, so a stream can't arrive
            # unencrypted
            allow publish 127.0.0.1;
            allow publish {{ wg_streamer_ip }};
{% if phone_camera | default(false) | bool %}
            allow publish {{ wg_phone_ip }};
{% endif %}
            deny publish all;

            # Layer 2: identity - the publisher must present the stream key
            # (rtmp://host:1935/live/<channel>?key=...). GET puts the RTMP
            # arguments in the query string so the http block can read them.
            notify_method get;
            on_publish http://127.0.0.1:8081/auth/publish;

            hls on;
            hls_path /var/www/html/stream/hls;
            # 2 s chunks: lower delay. A chunk can only be cut at a keyframe,
            # so the publishers send one every 2 s (ffmpeg: -force_key_frames;
            # the phone: Larix's keyframe frequency, 1 s)
            hls_fragment 2;
            hls_playlist_length 60;

            dash on;
            dash_path /var/www/html/stream/dash;
            dash_fragment 15s;
        }
    }
}
