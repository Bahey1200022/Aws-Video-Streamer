# {{ ansible_managed }}
user www-data;
worker_processes  1;
pid /run/nginx.pid;
# Loads ngx_rtmp_module (installed by libnginx-mod-rtmp)
include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections  1024;
}

http {
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;
    types_hash_max_size 2048;

    include         /etc/nginx/mime.types;
    include         /etc/nginx/sites-enabled/*;

    default_type    application/octet-stream;

    # Brute-force protection for the Studio login form (per client IP)
    limit_req_zone $binary_remote_addr zone=studio_login:1m rate=10r/m;

    server {
        # rtmp control: localhost only, never reachable from the network
        listen 127.0.0.1:8080;

        location /control {
            rtmp_control all;
        }
    }
}

rtmp {
    # The default RTMP log format records the connection arguments, which
    # include the stream key - log everything except them
    log_format rtmp_nokey '$remote_addr [$time_local] $command "$app" "$name" '
                          '$bytes_received $bytes_sent ($session_readable_time)';
    access_log /var/log/nginx/rtmp-access.log rtmp_nokey;

    server {
        listen 1935;
        chunk_size 4096;

        application live {
            live on;
            record off;

            # Layer 1: network - only the streamer's WireGuard address (or
            # localhost) may publish, so the stream can't arrive unencrypted
            allow publish 127.0.0.1;
            allow publish {{ wg_streamer_ip }};
            deny publish all;

            # Layer 2: identity - the publisher must present its channel's
            # stream key (rtmp://host:1935/live/<channel>?key=...). The Studio
            # checks it against its database; GET passes the RTMP arguments
            # in the query string.
            notify_method get;
            on_publish http://127.0.0.1:5000/studio/internal/publish-auth;

            hls on;
            hls_path /var/www/html/stream/hls;
            hls_fragment 3;
            hls_playlist_length 60;

            dash on;
            dash_path /var/www/html/stream/dash;
            dash_fragment 15s;
        }

        # Private Studio channels: HLS written outside the public /hls path
        # and only served through signed, expiring URLs (see streamer.site)
        application private {
            live on;
            record off;

            allow publish 127.0.0.1;
            deny publish all;
            deny play all;

            notify_method get;
            on_publish http://127.0.0.1:5000/studio/internal/publish-auth;

            hls on;
            hls_path /var/www/html/stream/private;
            hls_fragment 3;
            hls_playlist_length 60;
        }
    }
}
