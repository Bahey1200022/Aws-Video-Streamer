# {{ ansible_managed }}
# Data sources, provisioned as code (read-only in the Grafana UI)
apiVersion: 1
datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: http://127.0.0.1:9090
    isDefault: true
    editable: false
    jsonData:
      timeInterval: 15s

  # Logs: Loki listens on the private IP (the agents on the other servers
  # push to it), so Grafana uses that address too
  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: http://{{ monitoring_private_ip }}:3100
    editable: false
    jsonData:
      maxLines: 1000
