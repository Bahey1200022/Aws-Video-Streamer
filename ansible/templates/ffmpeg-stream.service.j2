[Unit]
Description=Stream {{ video_file }} in a loop to the frontend RTMP server
After=network-online.target wg-quick@wg0.service
Wants=network-online.target wg-quick@wg0.service

[Service]
# Holds STREAM_KEY; root-only so the key is not in this world-readable unit.
# systemd reads it (as root) before starting ffmpeg, so ffmpeg itself never
# needs to read the file.
EnvironmentFile=/etc/ffmpeg-stream.env
ExecStart=/usr/bin/ffmpeg -nostdin -loglevel warning \
  -stream_loop -1 \
  -re \
  -i {{ video_dir }}/{{ video_file }} \
  -c:v libx264 -preset veryfast \
  -c:a aac \
  -f flv \
  rtmp://{{ wg_frontend_ip }}:1935/live/stream?key=${STREAM_KEY}
Restart=always
RestartSec=5

# --- Sandbox (least privilege) ---
# ffmpeg parses complex media formats, a classic source of security bugs. It
# only needs to read one video file and send it to one address, so it runs
# as a throwaway unprivileged user with everything else taken away.
# Check the result with: systemd-analyze security ffmpeg-stream.service

# A temporary user created for this service only (not root)
DynamicUser=yes
# Can never gain privileges (no sudo/setuid), and holds no capabilities
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Read-only view of the system; no access to /home, /tmp or devices
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
UMask=0077
# No access to kernel settings, modules, logs, clock, hostname or cgroups
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Can't see other processes
ProtectProc=invisible
ProcSubset=pid
# No namespaces, realtime scheduling or personality changes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# Only the system calls a normal service needs
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# Network: IPv4 only, and only to the frontend's tunnel address
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow={{ wg_frontend_ip }}

[Install]
WantedBy=multi-user.target
