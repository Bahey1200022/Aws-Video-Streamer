# {{ ansible_managed }}
{% if tls_active %}
server {
    listen 80;
    server_name {{ fqdn }};

    # Let's Encrypt HTTP-01 challenges (issue and renewal) stay on plain HTTP
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type text/plain;
    }

    # Everything else moves to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

{% endif %}
server {
{% if tls_active %}
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/{{ cert_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ cert_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
{% if not letsencrypt_staging | bool %}
    # Browsers must use HTTPS for this site (only with a trusted cert). Kept to
    # one day: if a lab rebuild ever failed to get a new certificate, browsers
    # would otherwise refuse the site for a year.
    add_header Strict-Transport-Security "max-age=86400" always;
{% endif %}
{% else %}
    listen 80;
{% endif %}
    server_name {{ fqdn }};

    # Player page
    root /var/www/html;
    index index.html;

    # The web root contains the raw chunk folders (/var/www/html/stream/...).
    # Never serve them directly: protected channels would bypass their login.
    location ^~ /stream/ {
        return 404;
    }

{% if camera_enabled | bool %}
    # Camera channel: a private space, so viewing needs a login (over HTTPS)
    location ^~ /camera/ {
        auth_basic "Camera";
        auth_basic_user_file /etc/nginx/camera.htpasswd;
    }

    # Camera chunks live in their own folders (nginx-rtmp can't share one):
    # /hls/camera.m3u8 -> /var/www/html/stream/camera-hls/camera.m3u8
    location ^~ /hls/camera {
        auth_basic "Camera";
        auth_basic_user_file /etc/nginx/camera.htpasswd;
        add_header Cache-Control no-cache;
        alias /var/www/html/stream/camera-hls/camera;
    }

    location ^~ /dash/camera {
        auth_basic "Camera";
        auth_basic_user_file /etc/nginx/camera.htpasswd;
        add_header Cache-Control no-cache;
        types {
            application/dash+xml mpd;
            video/mp4 mp4 m4v m4a;
        }
        alias /var/www/html/stream/camera-dash/camera;
    }

{% endif %}
    location /hls {
        add_header Access-Control-Allow-Origin *;
        root /var/www/html/stream;
    }

    autoindex_localtime on;

    location /dash {
        # Disable cache
        add_header 'Cache-Control' 'no-cache';

        # CORS setup
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length';

        # Allow CORS preflight requests
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*';
            add_header 'Access-Control-Max-Age' 1728000;
            add_header 'Content-Type' 'text/plain charset=UTF-8';
            add_header 'Content-Length' 0;
            return 204;
        }

        types {
            application/dash+xml mpd;
            video/mp4 mp4;
        }

        root /var/www/html/stream;
    }
}
