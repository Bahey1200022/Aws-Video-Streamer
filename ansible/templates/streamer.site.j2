# {{ ansible_managed }}
{% if tls_active %}
server {
    listen 80;
    server_name {{ fqdn }};

    # Let's Encrypt HTTP-01 challenges (issue and renewal) stay on plain HTTP
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type text/plain;
    }

    # Everything else moves to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

{% endif %}
server {
{% if tls_active %}
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/{{ cert_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ cert_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
{% if not letsencrypt_staging | bool %}
    # Browsers must use HTTPS for this site (only with a trusted cert). Kept to
    # one day: if a lab rebuild ever failed to get a new certificate, browsers
    # would otherwise refuse the site for a year.
    add_header Strict-Transport-Security "max-age=86400" always;
{% endif %}
{% else %}
    listen 80;
{% endif %}
    server_name {{ fqdn }};

    # Player page
    root /var/www/html;
    index index.html;

    # The web root contains the raw chunk folders (/var/www/html/stream/...).
    # Never serve them directly: protected channels would bypass their login.
    location ^~ /stream/ {
        return 404;
    }

{% if camera_enabled | bool %}
    # Camera channel: a private space, so viewing needs a login (over HTTPS)
    location ^~ /camera/ {
        auth_basic "Camera";
        auth_basic_user_file /etc/nginx/camera.htpasswd;
    }

    # Camera chunks live in their own folders (nginx-rtmp can't share one):
    # /hls/camera.m3u8 -> /var/www/html/stream/camera-hls/camera.m3u8
    location ^~ /hls/camera {
        auth_basic "Camera";
        auth_basic_user_file /etc/nginx/camera.htpasswd;
        add_header Cache-Control no-cache;
        alias /var/www/html/stream/camera-hls/camera;
    }

    location ^~ /dash/camera {
        auth_basic "Camera";
        auth_basic_user_file /etc/nginx/camera.htpasswd;
        add_header Cache-Control no-cache;
        types {
            application/dash+xml mpd;
            video/mp4 mp4 m4v m4a;
        }
        alias /var/www/html/stream/camera-dash/camera;
    }

{% endif %}
{% if openweather_api_key %}
    # ---- Live weather: nginx fetches it server-side, so the API key never
    # reaches browsers and viewers' IPs are never sent to the weather service ----
    location = /api/weather {
        limit_req zone=weather_per_ip burst=10 nodelay;
        limit_req_status 429;

        # "set" must come before "rewrite ... break", which stops every later
        # rewrite-module directive (set included)
        set $weather_upstream api.openweathermap.org;

        # Fixed upstream request: visitors can't choose what is fetched (no SSRF,
        # no open proxy). The rewrite replaces any client query string.
        rewrite ^ "/data/2.5/weather?lat={{ weather_lat }}&lon={{ weather_lon }}&units=metric&appid={{ openweather_api_key }}" break;

        # Resolved at request time through the VPC's DNS: if the weather service
        # is unreachable only this endpoint fails - nginx still starts
        resolver 169.254.169.253 valid=300s ipv6=off;
        resolver_timeout 3s;
        proxy_pass https://$weather_upstream;

        # Verify the weather service's TLS certificate (nginx doesn't by default)
        proxy_ssl_server_name on;
        proxy_ssl_name api.openweathermap.org;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host api.openweathermap.org;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;

        # Fixed cache key: random query strings can't bypass the cache and burn
        # the quota. Serve a stale copy if the service is down.
        proxy_cache weather;
        proxy_cache_key "weather-{{ weather_lat }}-{{ weather_lon }}";
        proxy_cache_valid 200 10m;
        # Errors (e.g. a not-yet-active key) are cached briefly too, so a broken
        # upstream can't turn every page view into an API call
        proxy_cache_valid any 1m;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        proxy_hide_header Set-Cookie;
        add_header X-Cache $upstream_cache_status always;
        add_header Cache-Control "no-store" always;

        # The key is in the upstream URL, and nginx error lines include it:
        # only log critical errors for this endpoint
        error_log /var/log/nginx/weather-error.log crit;
    }

{% endif %}
    location /hls {
        add_header Access-Control-Allow-Origin *;
        root /var/www/html/stream;
    }

    autoindex_localtime on;

    location /dash {
        # Disable cache
        add_header 'Cache-Control' 'no-cache';

        # CORS setup
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length';

        # Allow CORS preflight requests
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*';
            add_header 'Access-Control-Max-Age' 1728000;
            add_header 'Content-Type' 'text/plain charset=UTF-8';
            add_header 'Content-Length' 0;
            return 204;
        }

        types {
            application/dash+xml mpd;
            video/mp4 mp4;
        }

        root /var/www/html/stream;
    }
}
