# {{ ansible_managed }}
[Interface]
Address = {{ wg_address }}/32
{% if wg_listen %}
ListenPort = {{ wg_port }}
{% endif %}
# The private key never leaves this host: it is generated here and loaded
# from disk, so it is not part of this file or of any Ansible variable
PostUp = wg set %i private-key /etc/wireguard/private.key
{% for peer in wg_peers %}

# {{ peer.name }}
[Peer]
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.ip }}/32
{% if peer.endpoint | default('') %}
Endpoint = {{ peer.endpoint }}
PersistentKeepalive = 25
{% endif %}
{% endfor %}
