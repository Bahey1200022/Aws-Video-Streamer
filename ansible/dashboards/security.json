{
  "uid": "mss-security",
  "title": "MSS - Security",
  "description": "Logs from the three servers (Loki): SSH logins, sudo, stream-key checks, scanners, errors.",
  "tags": [
    "mss"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Failed SSH logins",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (server) (count_over_time({identifier=\"sshd\"} |~ \"Failed password|Failed publickey|Invalid user|authentication failure|Connection closed by authenticating user\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{server}}"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Failed or invalid SSH logins over the selected time range. SSH is only open to one IP, so any failure is worth a look.",
      "id": 1
    },
    {
      "type": "stat",
      "title": "Rejected stream keys",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({log=\"publish-auth\"} |= \"result=403\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "rejected"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Publish attempts refused by the stream-key check (publish-auth.log, result=403).",
      "id": 2
    },
    {
      "type": "stat",
      "title": "Website 4xx responses",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({log=\"access\"} | regexp `^(?P<ip>\\S+) \\S+ \\S+ \\[[^\\]]+\\] \"(?P<method>\\S+) (?P<path>\\S+)[^\"]*\" (?P<class>\\d)\\d\\d ` | class=\"4\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "4xx"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Requests answered 4xx (mostly 404: scanners looking for files that don't exist).",
      "id": 3
    },
    {
      "type": "stat",
      "title": "Errors in system logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (server) (count_over_time({job=\"journal\", level=~\"error|crit|alert|emerg\"} [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{server}}"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Journal entries with priority error or worse.",
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Failed SSH logins over time",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (server) (count_over_time({identifier=\"sshd\"} |~ \"Failed password|Failed publickey|Invalid user|authentication failure|Connection closed by authenticating user\" [$__interval]))",
          "queryType": "range",
          "legendFormat": "{{server}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "description": "Bars per server.",
      "id": 5
    },
    {
      "type": "logs",
      "title": "Successful SSH logins (who, from where)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{identifier=\"sshd\"} |= \"Accepted\" | regexp `Accepted (?P<method>\\S+) for (?P<user>\\S+) from (?P<ip>\\S+)` | line_format \"{{.server}}: {{.user}} from {{.ip}} ({{.method}})\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "showLabels": false,
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Every accepted SSH login. Ansible logs in through the frontend (jump host), so its logins come from the frontend's private IP.",
      "id": 6
    },
    {
      "type": "logs",
      "title": "Stream-key checks (publish-auth)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{log=\"publish-auth\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "showLabels": false,
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Every publish attempt and the verdict: result=200 accepted, result=403 wrong key. The key itself is never logged.",
      "id": 7
    },
    {
      "type": "logs",
      "title": "Publisher sessions (RTMP)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{log=\"rtmp-access\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "showLabels": false,
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Who published, from which address (10.99.0.2 is the streamer through WireGuard), bytes received and duration.",
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Website requests by status",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (class) (count_over_time({log=\"access\"} | regexp `^(?P<ip>\\S+) \\S+ \\S+ \\[[^\\]]+\\] \"(?P<method>\\S+) (?P<path>\\S+)[^\"]*\" (?P<class>\\d)\\d\\d ` | class!=\"\" [$__interval]))",
          "queryType": "range",
          "legendFormat": "{{class}}xx"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "description": "Status classes: 2xx ok, 3xx redirects, 4xx client errors (scanners), 5xx server errors.",
      "id": 9
    },
    {
      "type": "table",
      "title": "Top IPs getting 4xx (scanners)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (ip) (count_over_time({log=\"access\"} | regexp `^(?P<ip>\\S+) \\S+ \\S+ \\[[^\\]]+\\] \"(?P<method>\\S+) (?P<path>\\S+)[^\"]*\" (?P<class>\\d)\\d\\d ` | class=\"4\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Addresses with the most 4xx answers over the selected time range.",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "ip": "IP",
              "Value": "4xx answers"
            }
          }
        }
      ],
      "id": 10
    },
    {
      "type": "logs",
      "title": "Paths requested by scanners (4xx)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{log=\"access\"} | regexp `^(?P<ip>\\S+) \\S+ \\S+ \\[[^\\]]+\\] \"(?P<method>\\S+) (?P<path>\\S+)[^\"]*\" (?P<class>\\d)\\d\\d ` | class=\"4\" | line_format \"{{.ip}} {{.method}} {{.path}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "showLabels": false,
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "What the scanners were looking for.",
      "id": 11
    },
    {
      "type": "logs",
      "title": "nginx errors",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{log=\"error\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "showLabels": false,
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "nginx's error log (files not found, upstream problems...).",
      "id": 12
    },
    {
      "type": "logs",
      "title": "Commands run with sudo (Ansible hidden)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{identifier=\"sudo\"} |= \"COMMAND=\" != \"BECOME-SUCCESS\" | regexp `USER=(?P<as>\\S+) ; COMMAND=(?P<command>.*)` | line_format \"{{.server}} as {{.as}}: {{.command}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "showLabels": false,
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Commands typed with sudo. Ansible's own sudo calls (BECOME-SUCCESS) are hidden: they happen on every deployment.",
      "id": 13
    },
    {
      "type": "logs",
      "title": "ffmpeg (streamer)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{unit=\"ffmpeg-stream.service\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "showLabels": false,
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "ffmpeg only logs warnings and errors, so this is normally empty. Connection errors appear when the frontend restarts.",
      "id": 14
    },
    {
      "type": "logs",
      "title": "Errors from all servers",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"journal\", level=~\"error|crit|alert|emerg\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "showLabels": false,
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Live view of every error-level journal entry.",
      "id": 15
    }
  ]
}
