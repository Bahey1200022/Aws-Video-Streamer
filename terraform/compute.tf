data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"] # Canonical

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }
}

# SSH key generated by Terraform so a fresh apply needs no manual setup
resource "tls_private_key" "ssh" {
  algorithm = "ED25519"
}

resource "aws_key_pair" "mss" {
  key_name   = "mss-key"
  public_key = tls_private_key.ssh.public_key_openssh
}

resource "local_sensitive_file" "ssh_private_key" {
  content         = tls_private_key.ssh.private_key_openssh
  filename        = "${path.module}/mss-key.pem"
  file_permission = "0600"
}

resource "aws_instance" "frontend" {
  ami                    = data.aws_ami.ubuntu.id
  instance_type          = var.instance_type
  subnet_id              = data.aws_subnet.public.id
  vpc_security_group_ids = [aws_security_group.frontend.id]
  key_name               = aws_key_pair.mss.key_name
  iam_instance_profile   = data.aws_iam_instance_profile.frontend.name

  associate_public_ip_address = true
  source_dest_check           = false # required to forward the streamer's traffic

  user_data = templatefile("${path.module}/nat.sh", {
    private_cidr = data.aws_subnet.private.cidr_block
  })

  # IMDSv2 only: credentials require a session token obtained with a PUT,
  # which SSRF-style plain GET requests can't do
  metadata_options {
    http_endpoint               = "enabled"
    http_tokens                 = "required"
    http_put_response_hop_limit = 1
  }

  # Disk encrypted at rest with our KMS key (envelope encryption)
  root_block_device {
    encrypted  = true
    kms_key_id = aws_kms_key.ebs.arn
  }

  tags = { Name = "mss-web-frontend" }

  lifecycle {
    # - associate_public_ip_address: AWS reports false while the instance is
    #   stopped (no public IP); it still gets a new public IP when it starts
    # - ami: a newer Ubuntu image must not rebuild a running server; new
    #   servers still pick up the latest image
    ignore_changes = [associate_public_ip_address, ami]
  }
}

resource "aws_instance" "streamer" {
  ami                    = data.aws_ami.ubuntu.id
  instance_type          = var.instance_type
  subnet_id              = data.aws_subnet.private.id
  vpc_security_group_ids = [aws_security_group.streamer.id]
  key_name               = aws_key_pair.mss.key_name

  # IMDSv2 only: credentials require a session token obtained with a PUT,
  # which SSRF-style plain GET requests can't do
  metadata_options {
    http_endpoint               = "enabled"
    http_tokens                 = "required"
    http_put_response_hop_limit = 1
  }

  # Disk encrypted at rest with our KMS key (envelope encryption)
  root_block_device {
    encrypted  = true
    kms_key_id = aws_kms_key.ebs.arn
  }

  tags = { Name = "mss-video-streamer" }

  lifecycle {
    # A newer Ubuntu image must not rebuild a running server
    ignore_changes = [ami]
  }
}

# The lab account stops all instances at midnight. Bring them back up on every
# apply, then read the live instance so we get the new public IP.
resource "aws_ec2_instance_state" "frontend" {
  instance_id = aws_instance.frontend.id
  state       = "running"
}

resource "aws_ec2_instance_state" "streamer" {
  instance_id = aws_instance.streamer.id
  state       = "running"
}

data "aws_instance" "frontend" {
  instance_id = aws_ec2_instance_state.frontend.instance_id
}

locals {
  frontend_public_ip = data.aws_instance.frontend.public_ip
}

resource "aws_route53_record" "frontend" {
  count   = local.dns_enabled ? 1 : 0
  zone_id = data.aws_route53_zone.main[0].zone_id
  name    = "${var.frontend_hostname}.${var.domain_name}"
  type    = "A"
  ttl     = 60
  records = [local.frontend_public_ip]
}
