# Generated by Terraform - do not edit
all:
  vars:
    ansible_user: ubuntu
    ansible_ssh_private_key_file: ${key_file}
    fqdn: ${fqdn}
    private_cidr: ${private_cidr}
    vpc_cidr: ${vpc_cidr}
    frontend_private_ip: ${frontend_private_ip}
    enable_tls: ${enable_tls}
    letsencrypt_staging: ${letsencrypt_staging}
    stream_key: ${stream_key}
  children:
    frontend:
      hosts:
        web-frontend:
          ansible_host: ${frontend_public_ip}
    streamer:
      hosts:
        video-streamer:
          ansible_host: ${streamer_private_ip}
          # The streamer has no public IP: jump through the frontend
          ansible_ssh_common_args: >-
            -o ProxyCommand="ssh -i ${key_file} -o StrictHostKeyChecking=no
            -o UserKnownHostsFile=/dev/null -W %h:%p ubuntu@${frontend_public_ip}"
